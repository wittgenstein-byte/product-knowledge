PORT=4001
DB_HOST=mysql
DB_USER=si_user
DB_PASSWORD=si_password
DB_NAME=si_product_hub

# Google Sheets Configuration
GOOGLE_SHEETS_ID=YOUR_SPREADSHEET_ID_HERE
# Put the single-line JSON string representation of your service account key file here
GOOGLE_SERVICE_ACCOUNT_KEY={"type": "service_account", "project_id": "...", ...}
# Or specify the path to your service account JSON file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/app/credentials/google-key.json
